.program loopback
.side_set 1

; Test-only serial loopback engine. One bit is driven and sampled per lane.
; With a 1-cycle PIO clock divider, the input is sampled one PIO cycle after
; the output changes. The strobe is high during the sample instruction.
.wrap_target
    pull block side 0
    set x, 31 side 0
loop:
    out pins, 1 side 0
    in pins, 1 side 1
    jmp x-- loop side 0
    push block side 0
.wrap
